# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/expense_approval

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=replace_with_your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Insight Service (Google Gemini) ---
GEMINI_API_KEY=insert_your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Routing: category -> approver email ---
CATEGORY_APPROVERS={"Office": "approver1@example.com", "Travel": "approver2@example.com", "Client Entertainment": "approver2@example.com", "Software/Subscriptions": "approver1@example.com", "Other": "approver1@example.com"}